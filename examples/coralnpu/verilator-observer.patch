@@ -393,4 +393,44 @@ module zvt_pe_array (
 // busy
   assign busy = |blkBusy;
 
+`ifdef LPN_VME_OBSERVE
+  // Passive observations at PE ingress and final accumulator writes.
+  integer lpnTraceFd = 0;
+  string lpnTracePath;
+  longint unsigned lpnCycle = 0;
+  initial begin
+    if ($value$plusargs("lpn_matrix_trace=%s", lpnTracePath)) begin
+      lpnTraceFd = $fopen(lpnTracePath, "w");
+      if (lpnTraceFd == 0) $fatal(1, "cannot open LPN matrix observation file");
+      $fdisplay(lpnTraceFd, "cycle,event,pc,block,tile,m,n,k,sew,batch");
+    end
+  end
+  always @(posedge clk) begin
+    if (!rst_n) lpnCycle <= 0;
+    else begin
+      lpnCycle <= lpnCycle + 1;
+      if (lpnTraceFd != 0) begin
+        if (canStart && blkCmdRdy[0] && cnt == 0)
+          $fdisplay(lpnTraceFd, "%0d,launch,0x%08x,0,%0d,%0d,%0d,%0d,%0d,0",
+                    lpnCycle, peCmd[0].uop_pc, peCmd[0].dst_index[4:1],
+                    peCmd[0].tm, peCmd[0].vl, peCmd[0].tk, peCmd[0].sew);
+        for (int b = 0; b < `NUM_BLK; b++) begin
+          if (blkCmdVld[b] && blkCmdRdy[b])
+            $fdisplay(lpnTraceFd, "%0d,batch,0x%08x,%0d,%0d,0,0,0,0,%0d",
+                      lpnCycle, blkCmd[b].vaInfo.uop_pc, b,
+                      blkCmd[b].vaInfo.readMtIdx, blkCmd[b].vaInfo.readMtId);
+          if (peRtVld[b])
+            $fdisplay(lpnTraceFd, "%0d,done,0x%08x,%0d,%0d,0,0,0,0,0",
+                      lpnCycle, writePc[b], b, writeMtIdx[b][0]);
+          if (|writeEn[b])
+            $fdisplay(lpnTraceFd, "%0d,write,0x%08x,%0d,%0d,0,0,0,0,%0d",
+                      lpnCycle, writePc[b], b, writeMtIdx[b][0],
+                      (writeSubIdx[b][0] - 2*(b%2))/4);
+        end
+        $fflush(lpnTraceFd);
+      end
+    end
+  end
+`endif
+
 endmodule
