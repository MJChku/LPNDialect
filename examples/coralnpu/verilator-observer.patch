 void CoreMiniAxi_tb::posedge() {
+  // Optional dispatch observations for the LPN performance model. This
+  // samples existing debug ports and does not alter DUT behavior.
+  static FILE *lpn_trace = []() -> FILE * {
+    const char *path = std::getenv("LPN_CORAL_TRACE");
+    if (!path) return nullptr;
+    FILE *file = std::fopen(path, "w");
+    CHECK(file != nullptr);
+    std::fprintf(file, "cycle,lane,pc,inst\n");
+    return file;
+  }();
+  if (lpn_trace && resetn.read()) {
+#define LPN_DISPATCH_TRACE(x) \
+    if (debug_io_.dispatch_##x##_instFire.read()) \
+      std::fprintf(lpn_trace, "%llu,%u,0x%08x,0x%08x\n", \
+          static_cast<unsigned long long>(debug_io_.cycles.read().to_uint64()), \
+          x, debug_io_.dispatch_##x##_instAddr.read().to_uint(), \
+          debug_io_.dispatch_##x##_instInst.read().to_uint());
+    REPEAT(LPN_DISPATCH_TRACE, 4);
+#undef LPN_DISPATCH_TRACE
+    std::fflush(lpn_trace);
+  }
+  static FILE *lpn_writes = []() -> FILE * {
+    const char *path = std::getenv("LPN_CORAL_WRITEBACK");
+    if (!path) return nullptr;
+    FILE *file = std::fopen(path, "w");
+    CHECK(file != nullptr);
+    std::fprintf(file, "cycle,reg,value\n");
+    return file;
+  }();
+  if (lpn_writes && resetn.read()) {
+#define LPN_WRITEBACK_TRACE(x) \
+    if (debug_io_.regfile_writeData_##x##_valid.read()) \
+      std::fprintf(lpn_writes, "%llu,%u,0x%08x\n", \
+          static_cast<unsigned long long>(debug_io_.cycles.read().to_uint64()), \
+          debug_io_.regfile_writeData_##x##_bits_addr.read().to_uint(), \
+          debug_io_.regfile_writeData_##x##_bits_data.read().to_uint());
+    REPEAT(LPN_WRITEBACK_TRACE, 6);
+#undef LPN_WRITEBACK_TRACE
+    std::fflush(lpn_writes);
+  }
   const bool core_io_dbus_valid = debug_io_.dbus_valid;
   const bool core_io_dbus_write = debug_io_.dbus_bits_write;
   const uint64_t core_io_dbus_addr = debug_io_.dbus_bits_addr.read().to_uint64();
