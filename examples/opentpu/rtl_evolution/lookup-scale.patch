+// Experimental exact normalized reciprocal. One table, two independent read
+// ports; each predictor has one small signed multiply. All 2^23 corrections
+// are architecture constants generated by make_recip_rom.py, not model weights.
+module otpu_recip_rom
+  import otpu_fp::*;
+#(parameter int PORTS=2, TW=8,
+  parameter string COEFF_FILE="", CORRECTION_FILE="") (
+  input logic clk,rst,en,
+  input logic [PORTS-1:0] iv,
+  input logic [PORTS-1:0][22:0] fraction,
+  input logic [PORTS-1:0][TW-1:0] itag,
+  output logic [PORTS-1:0] ov,
+  output logic [PORTS-1:0][31:0] value,
+  output logic [PORTS-1:0][TW-1:0] otag
+);
+  initial if (PORTS<1 || PORTS>2) $fatal(1,"reciprocal ROM has one or two physical read ports");
+  (* ram_style="block" *) logic [50:0] coefficients [4096];
+  (* ram_style="block" *) logic [1:0] corrections [1<<23];
+`ifdef SYNTHESIS
+  initial begin
+    $readmemh(COEFF_FILE,coefficients);
+    $readmemh(CORRECTION_FILE,corrections);
+  end
+`else
+  initial begin
+    string coeff_path,correction_path;
+    coeff_path=COEFF_FILE;correction_path=CORRECTION_FILE;
+    void'($value$plusargs("recip_coeff=%s",coeff_path));
+    void'($value$plusargs("recip_correction=%s",correction_path));
+    if (coeff_path=="" || correction_path=="") $fatal(1,"missing reciprocal ROM files");
+    $readmemh(coeff_path,coefficients);
+    $readmemh(correction_path,corrections);
+  end
+`endif
+  for (genvar p=0;p<PORTS;p++) begin : g_port
+    logic [3:0] valid;
+    logic [TW-1:0] tags [4];
+    logic [2:0] zeros;
+    logic [50:0] coefficient;
+    logic [10:0] low;
+    logic signed [1:0] corr1,corr2,corr3;
+    logic signed [25:0] product;
+    logic [36:0] base2;
+    logic [24:0] rounded;
+    always_ff @(posedge clk) begin
+      if (rst) valid<='0;
+      else if (en) valid<={valid[2:0],iv[p]};
+      if (en) begin
+        // Stage 1: both architecture constants read synchronously.
+        coefficient<=coefficients[fraction[p][22:11]];
+        corr1<=$signed(corrections[fraction[p]]);
+        low<=fraction[p][10:0];
+        zeros[0]<=fraction[p]==0;
+        tags[0]<=itag[p];
+        // Stage 2: one signed 14x12 multiply, independent of float pipelines.
+        product<=$signed(coefficient[13:0])*$signed({1'b0,low});
+        base2<=coefficient[50:14];corr2<=corr1;
+        zeros[1]<=zeros[0];tags[1]<=tags[0];
+        // Stage 3: fixed-point linear prediction, rounded to an integer.
+        rounded<=25'(($signed({2'b00,base2})+39'(product)+39'sd2048)>>>12);
+        corr3<=corr2;zeros[2]<=zeros[1];tags[2]<=tags[1];
+        // Stage 4: restore the exact original significand, not ideal 1/x.
+        begin
+          logic signed [26:0] restored;
+          restored=$signed({2'b00,rounded})+27'(corr3);
+          value[p]<=zeros[2] ? F_ONE : {1'b0,8'd126,restored[22:0]};
+`ifndef SYNTHESIS
+          if (valid[2] && !zeros[2] && (restored<27'sd8388608 || restored>=27'sd16777216))
+            $fatal(1,"reciprocal ROM restored an invalid normalized significand");
+`endif
+        end
+        tags[3]<=tags[2];
+      end
+    end
+    assign ov[p]=valid[3];
+    assign otag[p]=tags[3];
+  end
+endmodule
+
+// Original fp_recip semantics, including FTZ and its deliberately defined
+// zero/large/NaN behavior. Normalization is exponent arithmetic around the
+// exhaustively verified table; no host-computed tensor values enter this path.
+module otpu_recip_lookup
+  import otpu_fp::*;
+#(parameter int PORTS=2,TW=8,
+  parameter string COEFF_FILE="",CORRECTION_FILE="") (
+  input logic clk,rst,en,
+  input logic [PORTS-1:0] iv,
+  input logic [PORTS-1:0][31:0] x,
+  input logic [PORTS-1:0][TW-1:0] itag,
+  output logic [PORTS-1:0] ov,
+  output logic [PORTS-1:0][31:0] value,
+  output logic [PORTS-1:0][TW-1:0] otag
+);
+  logic [PORTS-1:0][22:0] fraction;
+  logic [PORTS-1:0][TW+11:0] tags_in,tags_out;
+  logic [PORTS-1:0][31:0] normalized;
+  for (genvar p=0;p<PORTS;p++) begin : g_normalize
+    logic [31:0] scaled;
+    assign fraction[p]=x[p][22:0];
+    assign tags_in[p]={itag[p],x[p][31],x[p][30:23]==0,
+        x[p][30:0]>=31'h7e800000,9'd127-{1'b0,x[p][30:23]}};
+    assign scaled=normalized[p]+{tags_out[p][8:0],23'd0};
+    assign value[p]=tags_out[p][10] ? F_ZERO : tags_out[p][9] ? {tags_out[p][11],31'd0} :
+        (tags_out[p][11] ? fneg(scaled) : scaled);
+    assign otag[p]=tags_out[p][TW+11:12];
+  end
+  otpu_recip_rom #(.PORTS(PORTS),.TW(TW+12),.COEFF_FILE(COEFF_FILE),
+      .CORRECTION_FILE(CORRECTION_FILE)) u_rom (
+    .clk,.rst,.en,.iv,.fraction,.itag(tags_in),.ov,.value(normalized),.otag(tags_out));
+endmodule
