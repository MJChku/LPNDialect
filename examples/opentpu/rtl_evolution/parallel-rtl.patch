+  for (genvar p=0;p<P;p++) begin : g_core
+    cmd_t subcmd;
+    logic [15:0] blk, blk2;
+    logic [7:0] grp;
+    logic [0:0] hi, ren;
+    logic [D*8-1:0] data;
+    logic [63:0] scale;
+    logic [ROWS-1:0] bank_ren;
+    logic [ROWS*D*8-1:0] bank_data;
+    logic [ROWS*64-1:0] bank_scale;
+    logic [7:0] group_q;
