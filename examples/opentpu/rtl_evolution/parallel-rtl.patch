+      .a_addr(a_addr[p]), .b_addr(b_addr[p]), .a_gnt(mem_gnt[p]), .b_gnt(mem_gnt[p]),
+      .a_rvalid(a_rvalid[p]), .b_rvalid(b_rvalid[p]), .a_rdata(a_rdata[p]), .b_rdata(b_rdata[p]),
+      .t_ren(re[p]), .t_raddr(ra[p]), .t_rdata(t_rdata[CP*p+:CP]),
+      .t_wen(we[p]), .t_waddr(wa[p]), .t_wdata(wd[p]), .t_gnt(cg[p]), .rmax_write(rm[p]), .head_epoch(epochs[p]));
