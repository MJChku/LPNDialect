diff --git a/rtl/mxu/otpu_mxu_parallel.sv b/rtl/mxu/otpu_mxu_parallel.sv
new file mode 100644
index 00000000..3d8229da
--- /dev/null
+++ b/rtl/mxu/otpu_mxu_parallel.sv
@@ -0,0 +1,214 @@
+// Independent streamed weight-row engines. The instruction/scoreboard contract
+// remains one MM: no unit reports completion until every row and epilogue lands.
+// Physical row p consumes p, p+P, ...; each core reuses the upstream systolic
+// integer/FP datapath. ACT storage is replicated for independent read addresses.
+module otpu_mxu_parallel
+  import otpu_pkg::*;
+  import otpu_fp::*;
+#(parameter int D=128, P=32, ROWS=16, BLOCKS=64, DEPTH=128,
+  parameter int LANES=64, CL=16, SID=0) (
+  input logic clk, rst, start, go,
+  input cmd_t cmd,
+  output logic rdy, done, computing,
+  output logic [$clog2(DEPTH):0] pf_level,
+  output logic pf_starve, pf_block, pf_u,
+  output logic [3:0][31:0] pf_uv,
+  input logic [LANES-1:0] act_we,
+  input logic [7:0] act_row, act_off,
+  input logic [31:0] act_idx,
+  input logic [LANES-1:0][7:0] act_data,
+  input logic act_dup, asc_we,
+  input logic [7:0] asc_row,
+  input logic [15:0] asc_blk,
+  input logic [63:0] asc_data,
+  output logic [P-1:0] a_req, b_req, a_want, b_want,
+  output logic [P-1:0][31:0] a_addr, b_addr,
+  input logic [P-1:0] mem_gnt, a_rvalid, b_rvalid,
+  input logic [P-1:0][255:0] a_rdata,
+  input logic [P-1:0][D*8-1:0] b_rdata,
+  output logic [LANES-1:0] t_ren, t_wen,
+  output logic [LANES-1:0][31:0] t_raddr, t_waddr, t_wdata,
+  input logic [LANES-1:0][31:0] t_rdata,
+  input logic t_gnt
+);
+  localparam int BW=$clog2(LANES);
+  localparam int CP=2;  // one result, or two contiguous ASCALE/RMAX words
+  initial if (LANES < CP*P) $fatal(1, "parallel MXU needs >=2 TMEM lanes per engine");
+  logic reducing;
+  logic [1:0] queue_count, head_epoch, tail_epoch, releases;
+  cmd_t entries [2];
+  wire cmd_t head=entries[head_epoch[0]];
+  wire busy=queue_count!=0;
+  wire core_go=releases!=0;
+  logic [P-1:0] cd, cr, cg, pop, rm;
+  logic [P-1:0][1:0] epochs;
+  logic [P-1:0] at_head;
+  for (genvar p=0;p<P;p++) assign at_head[p]=epochs[p]==head_epoch;
+  wire all_done=busy && !(|at_head);
+  logic [P-1:0][CP-1:0] re, we;
+  logic [P-1:0][CP-1:0][31:0] ra, wa, wd;
+  logic [P-1:0][$clog2(DEPTH):0] level;
+  logic [P-1:0] starve, block_;
+  logic [31:0] maxima [2][P][ROWS];
+  logic [7:0] flush_row;
+  int unsigned rr;
+  assign rdy = queue_count<2 && (&cr);
+  assign computing = |pop;
+  assign pf_u = done;
+  assign pf_uv = '0;
+  assign pf_starve = |starve;
+  assign pf_block = |block_;
+  // Profiling level is a per-engine high-water observation, not a sum that wraps.
+  always_comb begin
+    pf_level = '0;
