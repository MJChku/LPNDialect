+    if (go && queue_count==0 && !start) $fatal(1,"parallel MXU release without a command");
+    if (releases>2) $fatal(1,"parallel MXU release queue overflow");
+    if (queue_count>2) $fatal(1,"parallel MXU command queue overflow");
+  end
+`endif
+endmodule
