+      .w_dup(act_dup), .w_off(act_off), .swe(asc_we), .s_row(asc_row),
+      .s_blk(asc_blk), .s_data(asc_data), .ren(bank_ren), .r_use(pop[p]), .r_blk(blk),
+      .r_blk2(blk2), .r_hi({ROWS{1'b0}}), .r_grp(8'd0), .r_data(bank_data), .r_scale(bank_scale));
+    otpu_mxu #(.D(D), .MCOLS(1), .ROWS(ROWS), .DEPTH(DEPTH), .LANES(CP),
+        .CL(CL), .E(1), .NSTEP(P), .SID(SID)) u_mxu (
+      .clk, .rst, .start,
+      .go(core_go), .cmd(subcmd), .rdy(cr[p]),
