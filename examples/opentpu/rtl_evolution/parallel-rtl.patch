+    end
+    always_ff @(posedge clk) if (ren[0]) group_q<=grp;
+    assign data=bank_data[32'(group_q)*D*8+:D*8];
+    assign scale=bank_scale[32'(group_q)*64+:64];
+    always_comb begin
+      subcmd = cmd;
+      subcmd.w1 = cmd.w1 + p*cmd.w5;
+      subcmd.w2 = cmd.flags[3] ? cmd.w2 : cmd.w2 + p*cmd.w7;
+      subcmd.w3 = cmd.w3 + p;
+      subcmd.w4[15:0] = (32'(cmd.w4[15:0]) > p) ?
+                            16'((32'(cmd.w4[15:0])-p+P-1)/P) : 16'd0;
+      subcmd.w5 = cmd.w5 * P;
+      subcmd.w7 = cmd.w7 * P;
